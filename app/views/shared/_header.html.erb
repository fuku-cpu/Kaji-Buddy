<header class="navbar border-b border-base-300 px-6">
  <div class="flex items-center gap-2">
    <svg width="26" height="26" viewBox="0 0 30 30" fill="none">
      <circle cx="15" cy="15" r="14" stroke="currentColor" class="text-primary" stroke-width="1.6"/>
      <path d="M9 15.5L13 19.5L21 10.5" stroke="currentColor" class="text-primary" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
    <span class="font-mincho text-lg tracking-wide">kaji-buddy</span>
  </div>

  <% if user_signed_in? %>
    <div class="ml-auto flex items-center gap-2">
      <div class="avatar placeholder">
        <div class="bg-primary text-primary-content rounded-full w-7">
          <span class="text-xs"><%= current_user.name %></span>
        </div>
      </div>
      <span class="text-sm text-base-content/70"><%= current_user.name %>さん</span>
    </div>
  <% end %>
</header>