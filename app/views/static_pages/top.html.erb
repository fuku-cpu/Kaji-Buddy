<div class="min-h-screen flex flex-row justify-center items-center px-4">
  <div class="login-section pt-3">
    <div class="card bg-base-100 shadow-md text-center pt-5 mx-auto w-96">
      <h1 class="text-2xl font-bold">Kaji buddy</h1>

      <div class="card-body">
        <% if user_signed_in? %>
          <p class="mb-4">ログイン中です</p>
          <%= link_to "ログアウト", destroy_user_session_path,
                data: { turbo_method: :delete },
                class: "btn btn-primary w-full" %>
        <% else %>
          <p class="mb-4">ログインしていません</p>
          <%= link_to "ログイン", new_user_session_path,
                class: "btn btn-primary w-full" %>
        <% end %>
      </div>
    </div>
  </div>
</div>