<%= form_with url: chore_list_entries_path, method: :post,
              data: { controller: "chore-selection" }, class: "space-y-4" do %>
  <div class="flex items-center">
    <%= link_to "←", guide_chore_list_entries_path, class: "btn btn-ghost btn-sm" %>
    <h1 class="flex-1 text-center text-lg font-bold">家事帳から追加</h1>
  </div>

  <div class="flex justify-between rounded-box bg-base-200 p-4">
    <div>
      <p class="text-xs">今日の合計</p>
      <p class="text-2xl font-bold"><%= @today_total_minutes %>分</p>
    </div>
    <div class="text-right">
      <p class="text-xs">追加分</p>
      <p class="text-lg font-bold text-primary" data-chore-selection-target="added">+0分</p>
    </div>
  </div>

  <% @chores_by_category.each do |category, chores| %>
    <details class="collapse collapse-arrow border border-base-300 bg-base-100" open>
    <summary class="collapse-title font-bold">
      <%= category.name %>
      <span class="block text-xs font-normal"><%= chores.size %>件の家事</span>
    </summary>
    <div class="collapse-content p-0">
      <% chores.each do |chore| %>
        <% added = @added_chore_ids.include?(chore.id) %>
        <label class="group flex items-center justify-between border-t border-base-300 px-4 py-3
                     has-[:checked]:bg-primary/10 <%= added ? 'opacity-50' : 'cursor-pointer' %>">
          <%= check_box_tag "chore_ids[]", chore.id, false,
                id: "chore_#{chore.id}", class: "sr-only", disabled: added,
                data: { chore_selection_target: "checkbox",
                        minutes: chore.estimated_minutes,
                        action: "change->chore-selection#update" } %>
          <div>
            <p class="font-bold"><%= chore.name %></p>
            <p class="text-xs"><%= chore.estimated_minutes %>分</p>
          </div>
          <% if added %>
            <span class="badge badge-ghost badge-sm">追加済み</span>
          <% else %>
            <span class="btn btn-circle btn-outline btn-sm group-has-[:checked]:hidden">+</span>
            <span class="btn btn-circle btn-primary btn-sm hidden group-has-[:checked]:inline-flex">✓</span>
          <% end %>
        </label>
      <% end %>
    </div>
    </details>
  <% end %>

  <div class="sticky bottom-20">
    <%= submit_tag "選択した家事を追加する", class: "btn btn-primary btn-block",
          disabled: true, data: {chore_selection_target: "submit" } %>
  </div>
<% end %>